{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] },
    { "source": "/((?!css/|js/|fonts/|img/|vendor/|media/).*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/(css|js|fonts|img|vendor|media)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/(css|js|fonts|img|vendor)/(.*[.-][0-9a-f]{8,}\\.[a-z0-9]+)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "has": [{ "type": "host", "value": { "suf": ".vercel.app" } }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
